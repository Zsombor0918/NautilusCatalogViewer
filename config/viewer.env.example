# Copy to config/viewer.env and adjust for your machine.
NAUTILUS_CATALOG_ROOT=~/sync/catalog
NAUTILUS_VIEWER_CONVERT_REPORT_DIR=~/sync/convert_reports
NAUTILUS_VIEWER_CACHE_PATH=state/web_audit_cache.json
NAUTILUS_VIEWER_HOST=127.0.0.1
NAUTILUS_VIEWER_PORT=8000

# Leave unset to automatically load the latest YYYY-MM-DD.json report.
# NAUTILUS_VIEWER_CONVERT_REPORT_DATE=YYYY-MM-DD
